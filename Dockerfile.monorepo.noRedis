# syntax=docker/dockerfile:1.7

# ---------- Builder ----------
  FROM node:20-bookworm AS builder
  WORKDIR /app
  
  # 네이티브 모듈(예: sharp) 대비
  RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
  
  # Yarn v4
  RUN corepack enable && corepack prepare yarn@4.9.3 --activate
  
  # 🔧 전역 빌드 도구 보장 (tsc/tsx/nest)
  RUN npm i -g typescript@5 tsx@4 @nestjs/cli@^10
  
  # 루트 메타/TS 설정
  COPY package.json yarn.lock .yarnrc.yml tsconfig.json tsconfig.base.json ./
  
  # web 제외: 필요한 워크스페이스 manifest만 복사
  COPY apps/api/package.json apps/api/package.json
  COPY apps/worker/package.json apps/worker/package.json
  COPY libs/entities/package.json libs/entities/package.json
  COPY libs/logging/package.json libs/logging/package.json
  COPY libs/migrations/package.json libs/migrations/package.json
  
  # 필요한 워크스페이스 전부 설치 (devDeps 포함)
  RUN yarn workspaces focus \
    @catarie/api \
    @catarie/worker \
    @catarie/entities \
    @catarie/logging \
    @catarie/migrations \
    --all
  
  # 실제 소스 반입 (web 제외)
  COPY apps/api ./apps/api
  COPY apps/worker ./apps/worker
  COPY libs/entities ./libs/entities
  COPY libs/logging ./libs/logging
  COPY libs/migrations ./libs/migrations
  
  # 라이브러리 → 앱 순서로 빌드
  RUN yarn workspace @catarie/entities build \
   && yarn workspace @catarie/logging build \
   && yarn workspace @catarie/api build \
   && yarn workspace @catarie/worker build
  
  # ---------- Runtime ----------
  # 👉 slim 베이스로 변경하여 용량 절감
  FROM node:20-bookworm-slim AS runner
  WORKDIR /app
  ENV NODE_ENV=production
  
  # mysql 클라이언트(=mysql 명령) + CA 인증서만 최소 설치
  RUN apt-get update \
   && apt-get install -y --no-install-recommends default-mysql-client ca-certificates \
   && rm -rf /var/lib/apt/lists/*
  
  # 런타임에서 yarn/tsx 사용 보장(마이그 전용 커맨드에 필요)
  RUN corepack enable && corepack prepare yarn@4.9.3 --activate \
   && npm i -g tsx@4
  
  # 빌더 산출물 복사 (dist + node_modules 포함)
  COPY --from=builder /app /app
  
  # 🔻 용량 절감 (선택) — 소스맵/테스트 등 제거
  #   * 디버깅에 소스맵 필요하면 아래 줄을 주석 처리하세요.
  RUN find /app -type f -name '*.map' -delete || true
  
  # 진입 스크립트 생성 (heredoc 대신 printf 사용)
  RUN printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    '' \
    'case "${SERVICE:-api}" in' \
    '  api) exec node apps/api/dist/main.js ;;' \
    '  worker) exec node apps/worker/dist/main.js ;;' \
    '  migrate) exec yarn workspace @catarie/migrations migrate:run ;;' \
    '  *) echo "Unknown SERVICE: ${SERVICE:-} (expected: api | worker | migrate)" >&2; exit 1 ;;' \
    'esac' \
    > /entrypoint.sh && chmod +x /entrypoint.sh
  
  # API만 3000 사용 (worker/migrate는 포트 노출 불필요)
  EXPOSE 3000
  ENV SERVICE=api
  CMD ["/entrypoint.sh"]
  