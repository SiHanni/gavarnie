{
  "name": "gavarnie",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "web",
    "infra",
    "libs/*",
    "web"
  ],
  "scripts": {
    "build": "tsc -b -v",
    "build:clean": "rimraf apps/**/dist libs/**/dist",
    "dev:api": "NODE_ENV=development yarn workspace @gavarnie/api start:dev",
    "dev:worker": "NODE_ENV=development yarn workspace @gavarnie/worker start:dev",
    "dev:entities:watch": "yarn workspace @gavarnie/entities build:watch",
    "dev:all": "yarn workspace @gavarnie/entities build && concurrently -n ENTITIES,API,WORKER -c auto \"yarn workspace @gavarnie/entities build:watch\" \"yarn workspace @gavarnie/api start:dev\" \"yarn workspace @gavarnie/worker start:dev\""
  },
  "packageManager": "yarn@4.9.3",
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12"
  }
}
