# syntax=docker/dockerfile:1.7

############################
# Builder
############################
FROM node:20-bookworm AS builder
WORKDIR /app

# 네이티브 모듈 대비
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

# Yarn v4
RUN corepack enable && corepack prepare yarn@4.9.3 --activate

# 전역 빌드 도구 (tsc/tsx/nest)
RUN npm i -g typescript@5 tsx@4 @nestjs/cli@^10

# 루트 메타/TS 설정
COPY package.json yarn.lock .yarnrc.yml tsconfig.json tsconfig.base.json ./

# web 제외, 필요한 워크스페이스 manifest만
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY libs/entities/package.json libs/entities/package.json
COPY libs/logging/package.json libs/logging/package.json
COPY libs/migrations/package.json libs/migrations/package.json

# 필요한 워크스페이스 설치 (devDeps 포함)
RUN yarn workspaces focus \
  @catarie/api \
  @catarie/worker \
  @catarie/entities \
  @catarie/logging \
  @catarie/migrations \
  --all

# 실제 소스 반입 (web 제외)
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY libs/entities ./libs/entities
COPY libs/logging ./libs/logging
COPY libs/migrations ./libs/migrations

# 빌드 (libs → apps)
RUN yarn workspace @catarie/entities build \
 && yarn workspace @catarie/logging build \
 && yarn workspace @catarie/api build \
 && yarn workspace @catarie/worker build

# 불필요한 캐시(오프라인 캐시 등) 제거로 런타임 복사 용량 축소
RUN rm -rf .yarn/cache .yarn/unplugged .yarn/install-state.gz || true


############################
# Runtime (slim)
############################
FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

# mysql 클라이언트 + redis 툴/서버 + CA
# - redis-server까지 포함(옵션 실행 가능)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      default-mysql-client \
      redis-tools \
      redis-server \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# 런타임에서 yarn/tsx 사용 보장(마이그 전용 커맨드에 필요)
RUN corepack enable && corepack prepare yarn@4.9.3 --activate \
 && npm i -g tsx@4 \
 && npm cache clean --force >/dev/null 2>&1 || true

# 빌더 산출물 복사 (dist + node_modules 포함)
COPY --from=builder /app /app

# (선택) 소스맵 제거로 용량 절감
RUN find /app -type f -name '*.map' -delete || true

# (선택) 런타임에 불필요한 오프라인 캐시/메타 삭제
RUN rm -rf /app/.yarn/cache /app/.yarn/unplugged /app/.yarn/install-state.gz || true

# 진입 스크립트 (api/worker/migrate/redis/redis-cli)
RUN printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  '' \
  '# 기본: SERVICE=api | worker | migrate | redis | redis-cli' \
  'case "${SERVICE:-api}" in' \
  '  api)' \
  '    exec node apps/api/dist/main.js' \
  '    ;;' \
  '  worker)' \
  '    exec node apps/worker/dist/main.js' \
  '    ;;' \
  '  migrate)' \
  '    # DB 접속 ENV 필요' \
  '    exec yarn workspace @catarie/migrations migrate:run' \
  '    ;;' \
  '  redis)' \
  '    # 단독 Redis 서버 실행(동일 컨테이너에서 앱과 동시 실행은 불가)' \
  '    # 기본은 메모리만 사용(appendonly 비활성). 필요 시 환경변수로 덮어쓰기.' \
  '    REDIS_ARGS=${REDIS_ARGS:-"--save \"\" --appendonly no --protected-mode no --bind 0.0.0.0"}' \
  '    exec sh -lc "redis-server $REDIS_ARGS"' \
  '    ;;' \
  '  redis-cli)' \
  '    # 진단용 CLI' \
  '    exec sh -lc "redis-cli ${REDIS_CLI_ARGS:-}"' \
  '    ;;' \
  '  *)' \
  '    echo "Unknown SERVICE: ${SERVICE:-} (expected: api | worker | migrate | redis | redis-cli)" >&2' \
  '    exit 1' \
  '    ;;' \
  'esac' \
  > /entrypoint.sh \
 && chmod +x /entrypoint.sh

# API 포트
EXPOSE 3000
# (선택) Redis 포트도 노출하고 싶으면 주석 해제
# EXPOSE 6379

ENV SERVICE=api
CMD ["/entrypoint.sh"]
